{
  "name": "docsense",
  "private": true,
  "version": "2.0.0",
  "description": "Loan and contract intelligence: cited Q&A, structured term extraction, true-cost calculators and risk flags for loan agreements.",
  "license": "MIT",
  "engines": { "node": ">=20.19.0" },
  "workspaces": ["packages/*", "apps/*", "eval", "samples"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "migrate": "npm run migrate -w apps/server",
    "samples:generate": "npm run generate -w samples"
  }
}
