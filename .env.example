# Server
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Postgres with pgvector (local: docker compose up -d; prod: Neon connection string)
DATABASE_URL=postgres://docsense:docsense@localhost:5432/docsense

# Gemini (Google AI Studio key). Free tier: content may be used by Google, so PII is masked before any call.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Ingestion limits
MAX_UPLOAD_MB=10
MAX_PAGES=60

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_WEIGHT=1
RETRIEVAL_TEXT_WEIGHT=1

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=30
RATE_LIMIT_LLM_MAX=10

# Scheduled cleanup (GitHub Actions calls POST /internal/cleanup with this bearer token)
CLEANUP_TOKEN=
DOCUMENT_TTL_HOURS=24

# Observability (optional)
SENTRY_DSN=
